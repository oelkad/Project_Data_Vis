  "cleaning_log": [
    {
      "step": "Schema harmonisation",
      "rows": 55302,
      "action": "Key column 'Accident_Id' (2022 file) renamed 'Num_Acc'; surrounding spaces stripped (values such as ' -1'); every value read as text, then typed explicitly."
    },
    {
      "step": "Dates & times",
      "rows": 0,
      "action": "Built a proper date from jour/mois/an (month coded '1' in 2020 vs '01' afterwards). Invalid dates: 0; invalid hrmn: 0."
    },
    {
      "step": "GPS coordinates",
      "rows": 21,
      "action": "Decimal commas converted to points. Points outside the bounding box of their own department are flagged (geo_ok = False) and left out of the point map only; they still count in every statistic (the department code is reliable)."
    },
    {
      "step": "Several road rows per accident",
      "rows": 31515,
      "action": "From 2023 the LIEUX file lists every road involved in an intersection (70,860 rows for 54,822 accidents in 2023). We keep the first row (main road) so the join stays one-to-one and accidents are not double-counted."
    },
    {
      "step": "Speed limit (vma)",
      "rows": 6524,
      "action": "58 values with an extra zero (500→50, 900→90…) corrected; 294 implausible values (1, 2, 5, 6 km/h…) and 6172 'not filled' (-1) set to missing."
    },
    {
      "step": "Age",
      "rows": 11146,
      "action": "Age = accident year − birth year. Missing birth year (mostly fleeing users added since 2021) or implausible age (28 rows, <0 or >105) → missing."
    },
    {
      "step": "Injury severity unknown (grav = -1)",
      "rows": 419,
      "action": "Users who fled the scene are recorded since 2021 without severity. They are kept in the table but excluded from victim counts."
    },
    {
      "step": "Road-user mode (feature)",
      "rows": 612181,
      "action": "31 vehicle codes (catv) grouped into 8 modes; pedestrians identified by catu = 3 (they are attached to the vehicle that hit them)."
    }
  ],
